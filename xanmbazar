<!DOCTYPE html>
<html lang="ku" dir="rtl" id="html-tag">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>خانم بازار - xanmbazar</title>
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root {
            --bg: #070a13;
            --card: #0f1626;
            --primary: #f43f5e;
            --text: #ffffff;
            --muted: #94a3b8;
            --success: #10b981;
            --danger: #ef4444;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding-bottom: 80px;
        }
        header {
            background-color: var(--card);
            padding: 15px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid #1e293b;
        }
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }
        .logo { font-size: 26px; font-weight: bold; color: var(--primary); text-transform: uppercase; letter-spacing: 1px; cursor: pointer; }
        .nav-actions { display: flex; align-items: center; gap: 15px; }
        .btn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-admin { background-color: #1e293b; color: white; }
        .cart-icon-btn { background: none; border: none; color: white; font-size: 24px; cursor: pointer; position: relative; }
        .cart-badge { position: absolute; top: -8px; right: -8px; background: var(--primary); color: white; font-size: 12px; padding: 2px 6px; border-radius: 50%; }

        .hero-banner {
            position: relative; width: 100%; height: 60vh;
            background: linear-gradient(rgba(7, 10, 19, 0.4), rgba(7, 10, 19, 0.95)), 
                        url('https://unsplash.com') no-repeat center center/cover;
            display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 20px; box-sizing: border-box;
        }
        .hero-banner h1 { font-size: 55px; color: var(--primary); margin: 0 0 10px 0; font-weight: 900; }
        .hero-banner p { font-size: 22px; margin: 0 0 20px 0; }
        .delivery-badge { background-color: rgba(244, 63, 94, 0.2); border: 1px solid var(--primary); padding: 12px 30px; border-radius: 30px; font-size: 18px; font-weight: bold; display: flex; align-items: center; gap: 10px; }

        .filter-section { max-width: 1200px; margin: 30px auto 10px auto; padding: 0 20px; }
        .filter-title { font-size: 18px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; color: var(--primary); }
        .categories-container, .sort-container { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; }
        .cat-card, .sort-card { background-color: var(--card); padding: 10px 22px; border-radius: 30px; white-space: nowrap; cursor: pointer; border: 1px solid #1e293b; font-size: 14px; }
        .cat-card.active, .cat-card:hover, .sort-card.active { background-color: var(--primary); color: white; font-weight: bold; }

        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 25px; padding: 20px; max-width: 1200px; margin: 0 auto; }
        .product-card { background-color: var(--card); border-radius: 14px; overflow: hidden; border: 1px solid #1e293b; display: flex; flex-direction: column; transition: 0.3s; }
        .product-card:hover { transform: translateY(-5px); }
        .product-img { height: 240px; background-color: #161f32; display: flex; align-items: center; justify-content: center; color: var(--muted); }
        .product-info { padding: 15px; flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .product-title { font-size: 16px; margin: 0 0 10px 0; font-weight: bold; }
        .price { color: var(--primary); font-weight: bold; font-size: 18px; margin-bottom: 10px; }
        .spec-select { width: 100%; padding: 8px; border-radius: 6px; background-color: var(--bg); color: white; border: 1px solid #1e293b; margin-bottom: 12px; }

        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.85); z-index: 1000; justify-content: center; align-items: center; overflow-y: auto; padding: 20px; box-sizing: border-box; }
        .modal-content { background-color: var(--card); padding: 30px; border-radius: 12px; width: 90%; max-width: 500px; border: 1px solid #1e293b; position: relative; max-height: 90vh; overflow-y: auto; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 14px; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #1e293b; background-color: var(--bg); color: white; box-sizing: border-box; }
        
        .cart-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #1e293b; }
        .cart-item-title { font-weight: bold; }
        .cart-item-price { color: var(--primary); }
        .remove-btn { background: none; border: none; color: var(--danger); cursor: pointer; }

        .admin-section { display: none; max-width: 1200px; margin: 20px auto; padding: 20px; background-color: var(--card); border-radius: 12px; }
        .order-box { background-color: var(--bg); padding: 15px; border-radius: 8px; border: 1px solid #1e293b; margin-bottom: 15px; position: relative; }
        .order-badge-new { position: absolute; top: 15px; left: 15px; background-color: var(--primary); color: white; padding: 2px 8px; border-radius: 4px; font-size: 12px; }

        footer { background-color: var(--card); padding: 30px 20px; text-align: center; margin-top: 5px; border-top: 1px solid #1e293b; }
        .social-links { display: flex; justify-content: center; gap: 20px; margin-bottom: 15px; }
        .social-link { color: white; font-size: 28px; transition: 0.3s; text-decoration: none; }
        .social-link:hover { color: var(--primary); transform: scale(1.1); }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <div class="logo" onclick="showMainPage()">xanmbazar</div>
            <div class="nav-actions">
                <button class="cart-icon-btn" onclick="openCartModal()"><i class="fa-solid fa-basket-shopping"></i><span class="cart-badge" id="cart-count">0</span></button>
                <button class="btn btn-admin" onclick="openLoginModal()" id="admin-nav-btn"><i class="fa-solid fa-lock"></i> ئەدمین</button>
                <button class="btn" onclick="toggleLanguage()" id="lang-btn">English</button>
            </div>
        </div>
    </header>

    <div id="hero-area" class="hero-banner">
        <h1>XANM BAZAR</h1>
        <p id="hero-desc">شیکترین و مۆدێرنترین بەرهەمەکان لای ئێمە بەدەست بهێنە</p>
        <div class="delivery-badge"><i class="fa-solid fa-truck-fast"></i><span id="delivery-text">گەیاندن هەیە بۆ هەموو شارەکانی کوردستان و عێراق</span></div>
    </div>

    <div id="user-page">
        <div class="filter-section">
            <div class="filter-title"><i class="fa-solid fa-layer-group"></i> <span id="txt-cats">پۆلەکان</span></div>
            <div class="categories-container">
                <div class="cat-card active" onclick="filterCategory('All')" data-ku="هەمووان" data-en="All">🏠 هەمووان</div>
                <div class="cat-card" onclick="filterCategory('Kids')" data-ku="منداڵان" data-en="Kids">👶 منداڵان</div>
                <div class="cat-card" onclick="filterCategory('Youth')" data-ku="گەنجان" data-en="Youth">⚡ گەنجان</div>
                <div class="cat-card" onclick="filterCategory('Women')" data-ku="ئافرەتان" data-en="Women">💃 ئافرەتان</div>
                <div class="cat-card" onclick="filterCategory('Boys')" data-ku="کوڕان" data-en="Boys">🙋‍♂️ کوڕان</div>
                <div class="cat-card" onclick="filterCategory('Cosmetics')" data-ku="جوانکاری" data-en="Cosmetics">💄 جوانکاری</div>
                <div class="cat-card" onclick="filterCategory('Perfumes')" data-ku="بۆن" data-en="Perfumes">✨ بۆن</div>
                <div class="cat-card" onclick="filterCategory('Accessories')" data-ku="ئێکسسوارات" data-en="Accessories">💍 ئێکسسوارات</div>
                <div class="cat-card" onclick="filterCategory('Mobile')" data-ku="پێداویستی مۆبایل" data-en="Mobile">📱 مۆبایل</div>
            </div>

            <div class="filter-title" style="margin-top:20px;"><i class="fa-solid fa-sliders"></i> <span id="txt-sort">ڕێکخستنی نرخەکان</span></div>
            <div class="sort-container">
                <div class="sort-card active" onclick="sortProducts('all')" id="sort-all">هەموو نرخەکان</div>
                <div class="sort-card" onclick="sortProducts('low')" id="sort-low">هەرزانترین نرخ</div>
                <div class="sort-card" onclick="sortProducts('mid')" id="sort-mid">ناوەند (20k - 50k)</div>
                <div class="sort-card" onclick="sortProducts('high')" id="sort-high">بەرزترین نرخ</div>
            </div>
        </div>
        <main class="products-grid" id="products-container"></main>
    </div>

    <div class="modal" id="cart-modal">
        <div class="modal-content">
            <h2 id="cart-title">سەبەتەی کڕینی تۆ</h2>
            <div id="cart-items-list"></div>
